#!/bin/bash
#PBS -N fix_parakeet_env
#PBS -l select=1:ngpus=1:ncpus=4:mem=16gb
#PBS -l walltime=01:30:00
#PBS -q g2
#PBS -P personal-REDACTED_NSCC_USER
#PBS -o logs/fix_parakeet_env.log
#PBS -e logs/fix_parakeet_env.log
#PBS -j oe

module load cuda/11.8.0
export LD_LIBRARY_PATH=/app/libs/cudnn/12-8.9.4.25/lib:$LD_LIBRARY_PATH

source /app/apps/miniforge3/25.3.1/etc/profile.d/conda.sh
conda activate /scratch/users/ntu/REDACTED_NSCC_USER/envs/parakeet_env

cd /scratch/users/ntu/REDACTED_NSCC_USER/indian-asr-bench
mkdir -p logs

echo "=== BEFORE ==="
python -c "import torch; print('torch:', torch.__version__); print('cuda build:', torch.version.cuda)" 2>/dev/null || echo "torch import failed"
python -c "import nemo; print('nemo:', nemo.__version__)" 2>/dev/null || echo "nemo import failed (expected if torch broken)"

# Remove broken CUDA-13.0 torch (handles both conda and pip installs)
conda remove -y pytorch torchaudio pytorch-cuda pytorch-mutex --force-remove 2>/dev/null || true
pip uninstall -y torch torchaudio torchvision 2>/dev/null || true

# Reinstall torch 2.5.1 cu118 via conda pytorch channel (matches task4_parakeet/nemo_asr_environment.yaml)
conda install -y \
    "pytorch==2.5.1" \
    "torchaudio==2.5.1" \
    "pytorch-cuda=11.8" \
    -c pytorch -c nvidia

echo "=== AFTER ==="
python -c "import torch; print('torch:', torch.__version__); print('cuda build:', torch.version.cuda)"
python -c "import nemo; print('nemo:', nemo.__version__)"
python -c "import nemo.collections.asr; print('nemo.collections.asr: OK')"

echo "=== GPU CHECK ==="
python -c "
import torch
print('cuda available:', torch.cuda.is_available())
if torch.cuda.is_available():
    print('GPU:', torch.cuda.get_device_name(0))
    print('Driver CUDA version:', torch.version.cuda)
else:
    print('FAIL - CUDA not available on GPU node, check driver/module')
"

echo "Fix done. Verify all checks pass before running job_parakeet.pbs"
