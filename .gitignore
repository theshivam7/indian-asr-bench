# OS
**/.DS_Store

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
**/*.ipynb_checkpoints/

# Environments
*.egg-info/
.venv/
venv/
env/
.env

# Cache
hf_cache/
hf_hub_cache/
pip_cache/
whisper_cache/

# Partial/temp files
*_partial.csv
*_interrupted.csv
*.wav
*.tmp

# Logs
logs/
/asr_throughput.o*
/asr_throughput.e*

# Fine-tuned model checkpoints (too large for git; uploaded to Hugging Face instead)
models/

# NSCC collector output: contains project id, uid, quota, internal hostnames.
# Kept locally under docs/nscc/ which is git-excluded.
nscc_final/
nscc_final.tar.gz

# Local-only, never published. Duplicated in .git/info/exclude, but that file is NOT
# versioned and does not survive a fresh clone, so the protection lives here too.
#   paper/   manuscript, figures, review notes
#   docs/    NSCC account records, audit scripts, working notes
paper/
docs/

# Per-clip Stage-2 output (one CSV per model x mode, about 200 MB across the three corpora)
# and the flat per-model top-20 dumps. normalize_and_score.py rebuilds all of it in minutes
# from the committed Stage-1 transcripts, and CI proves the rebuild is byte-identical, so
# only the aggregate wer_summary_all_models.{csv,md} is tracked. Run Stage 2 first on a
# fresh clone before any analysis/ script.
results/*/stage2_processed/*/
results/*/stage2_processed/top_20_high_wer_*.csv

# Regenerated figure in vector form. Nothing references it and matplotlib gives its
# clip-path ids fresh names each run, so tracking it produces a 300-line diff on every
# regeneration. The PNG that README embeds is byte-reproducible and stays tracked.
results/benchmark_overview.svg

# Staging area for removed code and results, kept locally until confirmed. See _deprecated/README.md.
_deprecated/
