#!/bin/bash
#PBS -N asr_ft_seeds
#PBS -l select=1:ngpus=1:ncpus=8:mem=32gb
#PBS -l walltime=24:00:00
#PBS -o logs/
#PBS -j oe
#PBS -k oed
#PBS -V

set -euo pipefail

# Multi-seed capacity study: train one Whisper size across N seeds, then transcribe and
# score each seed, so the fine-tuning delta can be reported as mean +/- SD across runs.
#
# The single-seed study cannot separate a real effect from run-to-run noise. This job
# closes that gap for one size; submit it once per size.
#
#   qsub -P <project_id> -v SIZE=tiny                         hpc/job_finetune_seeds.pbs
#   qsub -P <project_id> -v SIZE=medium,DATASET=aesrc         hpc/job_finetune_seeds.pbs
#   qsub -P <project_id> -v 'SIZE=small,SEEDS="42,43,44"'     hpc/job_finetune_seeds.pbs
#
# QUOTE SEEDS. qsub splits -v on commas, so an unquoted SEEDS=42,43,44 is read as
# SEEDS=42 followed by bare names 43 and 44, which PBS then tries to import from the
# submitting environment and rejects with "cannot send environment with the job".
# The inner double quotes keep the list as one value; the outer single quotes stop
# the shell from removing them.
#
# Walltime note: 6 seeds is 6 full training runs. Tiny fits comfortably in 24h; Small and
# especially Medium will not. For those, either raise walltime or split the seed list
# across several submissions (the runner skips seeds that are already scored, so
# resubmitting the same command after a walltime kill resumes rather than restarts).
#
# Submit serially, not in parallel: NSCC one-job GPU etiquette, and concurrent jobs would
# race on the shared stage-1 output directory.
#
# After every size has finished:
#   python analysis/compare_seeds.py --dataset ${DATASET}

DATASET=${DATASET:-aesrc}
SEEDS=${SEEDS:-42,43,44,45,46,47}

if [ -z "${SIZE:-}" ]; then
    echo "[FATAL] SIZE is not set. Submit with: qsub -P <project_id> -v SIZE=tiny $0"
    exit 1
fi
case "${SIZE}" in
    tiny|small|medium) ;;
    *) echo "[FATAL] SIZE must be 'tiny', 'small' or 'medium', got '${SIZE}'"; exit 1 ;;
esac

WORKDIR=${WORKDIR:-${PBS_O_WORKDIR:-$(pwd)}}
CONDA_BASE=${CONDA_BASE:-$(conda info --base 2>/dev/null || echo "/opt/conda")}
WHISPER_FT_ENV=${WHISPER_FT_ENV:-whisper_medium_ft}
# Default to scratch: $HOME is quota-limited on this cluster and a dataset cache
# will exhaust it mid-run, while scratch has room. Override with -v HF_CACHE=...
HF_CACHE=${HF_CACHE:-${SCRATCH:-/scratch/users/ntu/$USER}/hf_cache}
CUDA_MODULE=${CUDA_MODULE:-cuda/11.8.0}
MODELS_ROOT=${MODELS_ROOT:-models}

module load "${CUDA_MODULE}" 2>/dev/null || true
source "${CONDA_BASE}/etc/profile.d/conda.sh"
export HF_DATASETS_CACHE="${HF_CACHE}" HF_HOME="${HF_CACHE}" XDG_CACHE_HOME="${HF_CACHE}"
mkdir -p "${HF_CACHE}" "${WORKDIR}/logs" "${WORKDIR}/${MODELS_ROOT}"
cd "${WORKDIR}"

conda activate "${WHISPER_FT_ENV}" || { echo "[FATAL] conda activate failed for '${WHISPER_FT_ENV}'"; conda info --envs; exit 1; }
export LD_LIBRARY_PATH="${CONDA_PREFIX}/lib:${LD_LIBRARY_PATH:-}"

echo "--- GPU / CUDA diagnostics (${SIZE} on ${DATASET}, seeds ${SEEDS}) ---"
nvidia-smi --query-gpu=name,memory.used,memory.total --format=csv 2>&1 || echo "[WARN] nvidia-smi unavailable"
python -c "import torch,sys; ok=torch.cuda.is_available(); print('torch sees CUDA:', ok); sys.exit(0 if ok else 1)" \
    || { echo "[FATAL] CUDA not available in ${WHISPER_FT_ENV} - aborting"; exit 1; }

# The pretrained HF-pipeline baseline is shared by every seed (only the fine-tune varies),
# so it is transcribed once here rather than N times inside the loop.
BASELINE_CSV="results/${DATASET}/stage1_raw_transcripts/wer_${SIZE}_hf_raw.csv"
if [ -f "${BASELINE_CSV}" ]; then
    echo "=== baseline ${SIZE}_hf already transcribed, skipping ==="
else
    echo "=== transcribe ${SIZE}_hf (pretrained, same HF pipeline) on ${DATASET} test ==="
    DATASET="${DATASET}" MODEL_NAME="${SIZE}_hf" MODEL_SOURCE="openai/whisper-${SIZE}" \
        python finetune/evaluate_finetuned.py \
        || { echo "[FATAL] baseline transcription failed"; exit 1; }
    python normalize_and_score.py --dataset "${DATASET}" --models "${SIZE}_hf" \
        || { echo "[FATAL] baseline scoring failed"; exit 1; }
fi

echo "=== multi-seed fine-tuning: ${SIZE} on ${DATASET}, seeds ${SEEDS} $(date) ==="
bash finetune/run_seeds.sh --size "${SIZE}" --dataset "${DATASET}" \
    --seeds "${SEEDS}" --models-root "${MODELS_ROOT}"

echo "=== ${SIZE} multi-seed study on ${DATASET} complete $(date) ==="
echo "Aggregate once every size is done:"
echo "    python analysis/compare_seeds.py --dataset ${DATASET}"
