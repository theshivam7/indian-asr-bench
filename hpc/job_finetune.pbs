#!/bin/bash
#PBS -N whisper_medium_ft
#PBS -l select=1:ngpus=1:ncpus=8:mem=64gb
#PBS -l walltime=10:00:00
#PBS -P ${PBS_PROJECT:-your_project_id}
#PBS -o logs/finetune.log
#PBS -e logs/finetune.log
#PBS -j oe
#PBS -k oed
#PBS -V
# -V forwards the submitting shell's environment (HF_CACHE, WHISPER_FT_ENV, WORKDIR, ...)
# to the compute node. Without it, HF_CACHE falls back to $HOME and the dataset download
# hits the HOME disk quota. Export HF_CACHE to a scratch path before qsub, and pass the
# project on the command line since #PBS directives are not shell-expanded:
#   qsub -P <project_id> hpc/job_finetune.pbs

# Stage 0 — fine-tune Whisper Medium on the TIE_shorts train split.
# PBS_O_WORKDIR is set automatically by the scheduler to the directory `qsub` was run from —
# a much safer fallback than $(pwd), which for a PBS batch job defaults to $HOME, not the
# submission directory, if WORKDIR wasn't explicitly exported before qsub.
WORKDIR=${WORKDIR:-${PBS_O_WORKDIR:-$(pwd)}}
CONDA_BASE=${CONDA_BASE:-$(conda info --base 2>/dev/null || echo "/opt/conda")}
WHISPER_FT_ENV=${WHISPER_FT_ENV:-whisper_medium_ft}
# Default to scratch: $HOME is quota-limited on this cluster and a dataset cache
# will exhaust it mid-run, while scratch has room. Override with -v HF_CACHE=...
HF_CACHE=${HF_CACHE:-${SCRATCH:-/scratch/users/ntu/$USER}/hf_cache}
CUDA_MODULE=${CUDA_MODULE:-cuda/11.8.0}

module load "${CUDA_MODULE}" 2>/dev/null || true

source "${CONDA_BASE}/etc/profile.d/conda.sh"
conda activate "${WHISPER_FT_ENV}" || { echo "[FATAL] conda activate failed for '${WHISPER_FT_ENV}'"; conda info --envs; exit 1; }
# Conda's activation hooks (which normally put conda-forge ffmpeg's libavutil/etc on the
# loader path) don't always fire in a non-interactive PBS batch shell. Without this,
# torchcodec's "cannot open shared object file" for libavutil.so.5x is a path problem,
# not a missing/incompatible ffmpeg — it's installed, just not found at runtime.
export LD_LIBRARY_PATH="${CONDA_PREFIX}/lib:${LD_LIBRARY_PATH}"

export HF_DATASETS_CACHE="${HF_DATASETS_CACHE:-$HF_CACHE}"
export HF_HOME="${HF_HOME:-$HF_CACHE}"
mkdir -p "${HF_CACHE}" "${WORKDIR}/logs" "${WORKDIR}/models"

cd "${WORKDIR}"

# Optional training overrides (defaults in finetune_medium.py):
#   export FT_EPOCHS=10 FT_BATCH=8 FT_GRAD_ACCUM=2 FT_LR=1e-5 FT_PATIENCE=2
python finetune/finetune_medium.py
