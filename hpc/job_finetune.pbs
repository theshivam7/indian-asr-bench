#!/bin/bash
#PBS -N whisper_medium_ft
#PBS -l select=1:ngpus=1:ncpus=8:mem=64gb
#PBS -l walltime=10:00:00
#PBS -P ${PBS_PROJECT:-your_project_id}
#PBS -o logs/finetune.log
#PBS -e logs/finetune.log
#PBS -j oe

# Stage 0 — fine-tune Whisper Medium on the TIE_shorts train split.
WORKDIR=${WORKDIR:-$(pwd)}
CONDA_BASE=${CONDA_BASE:-$(conda info --base 2>/dev/null || echo "/opt/conda")}
WHISPER_FT_ENV=${WHISPER_FT_ENV:-whisper_medium_ft}
HF_CACHE=${HF_CACHE:-${HOME}/.cache/huggingface}
CUDA_MODULE=${CUDA_MODULE:-cuda/11.8.0}

module load "${CUDA_MODULE}" 2>/dev/null || true

source "${CONDA_BASE}/etc/profile.d/conda.sh"
conda activate "${WHISPER_FT_ENV}"

export HF_DATASETS_CACHE="${HF_CACHE}"
export HF_HOME="${HF_CACHE}"
mkdir -p "${HF_CACHE}" "${WORKDIR}/logs" "${WORKDIR}/models"

cd "${WORKDIR}"

# Optional training overrides (defaults in finetune.py):
#   export FT_EPOCHS=10 FT_BATCH=8 FT_GRAD_ACCUM=2 FT_LR=1e-5 FT_PATIENCE=2
python task6_whisper_medium_ft/finetune.py
