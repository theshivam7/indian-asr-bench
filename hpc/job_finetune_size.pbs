#!/bin/bash
#PBS -N asr_ft_size
#PBS -l select=1:ngpus=1:ncpus=8:mem=32gb
#PBS -l walltime=8:00:00
#PBS -P ${PBS_PROJECT:-your_project_id}
#PBS -o logs/
#PBS -j oe
#PBS -k oed
#PBS -V

# Capacity study: fine-tune Whisper Tiny or Small on TIE_shorts' official split (minimal
# protocol — one run, no disjoint/size-matched seeds — see
# results/tie/analysis/findings_tiny_small_ft.md). Uses the step-based recipe adapted from
# the professor's script (task6_whisper_medium_ft/finetune_stepwise.py), NOT the epoch-based
# finetune.py used for the medium study — see that script's docstring for the disclosed
# recipe deltas (effective batch 32 vs 16, fp16 vs bf16, no SpecAugment/early stopping,
# different checkpoint-selection normalizer).
#
#   qsub -v SIZE=tiny  hpc/job_finetune_size.pbs
#   qsub -v SIZE=small hpc/job_finetune_size.pbs
#
# Runs FT + both post-FT HF-pipeline evals (fine-tuned and pretrained-via-HF baseline) in
# one job so the size's engine-controlled comparison is self-contained. Submit serially
# (afterany-chained), not in parallel — see hpc/README.md; job_whisper.pbs's fixed log
# filename and NSCC's one-job GPU etiquette both assume one job at a time.

if [ -z "${SIZE}" ]; then
    echo "[FATAL] SIZE is not set. Submit with: qsub -v SIZE=tiny $0  (or SIZE=small)"
    exit 1
fi
case "${SIZE}" in
    tiny|small) ;;
    *) echo "[FATAL] SIZE must be 'tiny' or 'small', got '${SIZE}'"; exit 1 ;;
esac

WORKDIR=${WORKDIR:-${PBS_O_WORKDIR:-$(pwd)}}
CONDA_BASE=${CONDA_BASE:-$(conda info --base 2>/dev/null || echo "/opt/conda")}
WHISPER_FT_ENV=${WHISPER_FT_ENV:-whisper_medium_ft}
HF_CACHE=${HF_CACHE:-${HOME}/.cache/huggingface}
CUDA_MODULE=${CUDA_MODULE:-cuda/11.8.0}

module load "${CUDA_MODULE}" 2>/dev/null || true
source "${CONDA_BASE}/etc/profile.d/conda.sh"
export HF_DATASETS_CACHE="${HF_CACHE}" HF_HOME="${HF_CACHE}" XDG_CACHE_HOME="${HF_CACHE}"
mkdir -p "${HF_CACHE}" "${WORKDIR}/logs" "${WORKDIR}/models"
cd "${WORKDIR}"

conda activate "${WHISPER_FT_ENV}"
export LD_LIBRARY_PATH="${CONDA_PREFIX}/lib:${LD_LIBRARY_PATH}"

echo "--- GPU / CUDA diagnostics (${SIZE} capacity-study fine-tune) ---"
nvidia-smi --query-gpu=name,memory.used,memory.total --format=csv 2>&1 || echo "[WARN] nvidia-smi unavailable"
python -c "import torch,sys; ok=torch.cuda.is_available(); print('torch sees CUDA:', ok); sys.exit(0 if ok else 1)" \
    || { echo "[FATAL] CUDA not available in ${WHISPER_FT_ENV} - aborting"; exit 1; }

# Keep weights off the quota-limited $HOME.
FT_OUT="${FT_SIZE_OUTPUT:-models/whisper_${SIZE}_ft}"
mkdir -p "$(dirname "${FT_OUT}")"

echo "=== Stage 0: fine-tune whisper-${SIZE} (step-based recipe) $(date) ==="
python task6_whisper_medium_ft/finetune_stepwise.py \
    --base-model "openai/whisper-${SIZE}" --output-dir "${FT_OUT}"

echo "=== Stage 1: transcribe ${SIZE}_ft on test ==="
MODEL_NAME="${SIZE}_ft" MODEL_SOURCE="${FT_OUT}" \
    python task6_whisper_medium_ft/wer_whisper_medium_ft.py

echo "=== Stage 1: transcribe ${SIZE}_hf (pretrained, same HF pipeline) on test ==="
MODEL_NAME="${SIZE}_hf" MODEL_SOURCE="openai/whisper-${SIZE}" \
    python task6_whisper_medium_ft/wer_whisper_medium_ft.py

# Stage 2/3 deliberately NOT run here (same race-avoidance as the disjoint/sizematch seed
# jobs): after tiny AND small both finish, run ONE scoring pass:
#   python normalize_and_score.py --dataset tie && python analysis/compare_finetune.py
echo "=== ${SIZE} capacity-study fine-tune complete (raw CSVs written; scoring deferred) $(date) ==="
