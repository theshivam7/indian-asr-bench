#!/bin/bash
#PBS -N asr_bench_svarah
#PBS -l select=1:ngpus=1:ncpus=8:mem=64gb
#PBS -l walltime=10:00:00
#PBS -P ${PBS_PROJECT:-your_project_id}
#PBS -o logs/svarah.log
#PBS -e logs/svarah.log
#PBS -j oe
#PBS -k oed

# Full Svarah benchmark: 7 models -> Stage 2 -> Stage 3 (compare + statistics +
# error analysis + NEER). Svarah is gated on HF: run `huggingface-cli login` (or set
# HF_TOKEN) once so the download works. NOTE: verify the Svarah column names print by
# utils/datasets on first load and, if they differ, fix the SVARAH DatasetSpec in
# utils/registry.py (currently verified=False) before trusting the results.

WORKDIR=${WORKDIR:-$(pwd)}
CONDA_BASE=${CONDA_BASE:-$(conda info --base 2>/dev/null || echo "/opt/conda")}
WHISPER_ENV=${WHISPER_ENV:-whisper}
PARAKEET_ENV=${PARAKEET_ENV:-parakeet}
QWEN3_ENV=${QWEN3_ENV:-qwen3}
HF_CACHE=${HF_CACHE:-${HOME}/.cache/huggingface}
CUDA_MODULE=${CUDA_MODULE:-cuda/11.8.0}

module load "${CUDA_MODULE}" 2>/dev/null || true
source "${CONDA_BASE}/etc/profile.d/conda.sh"
export HF_DATASETS_CACHE="${HF_CACHE}" HF_HOME="${HF_CACHE}" XDG_CACHE_HOME="${HF_CACHE}"
mkdir -p "${HF_CACHE}" "${WORKDIR}/logs"
cd "${WORKDIR}"

echo "=== Svarah pipeline started $(date) on $(hostname) ==="

echo "--- GPU / CUDA diagnostics ---"
nvidia-smi --query-gpu=name,memory.used,memory.total --format=csv 2>&1 || echo "[WARN] nvidia-smi unavailable"

# Stage 1 — Whisper family (base / medium / large / large-v3-turbo)
conda activate "${WHISPER_ENV}"
# Conda's activation hooks don't always fully update PATH/LD_LIBRARY_PATH in a
# non-interactive PBS batch shell (same quirk documented in job_finetune.pbs) —
# without this, openai-whisper's ffmpeg subprocess call silently fails per-clip.
export PATH="${CONDA_PREFIX}/bin:${PATH}" LD_LIBRARY_PATH="${CONDA_PREFIX}/lib:${LD_LIBRARY_PATH}"
python -c "import torch,sys; ok=torch.cuda.is_available(); print('torch sees CUDA:', ok, '| device count:', torch.cuda.device_count()); sys.exit(0 if ok else 1)" \
    || { echo "[FATAL] CUDA not available in ${WHISPER_ENV} - aborting before a CPU-bound run"; exit 1; }
for M in base medium large large_v3_turbo; do
  echo -e "\n=== Svarah Stage 1: whisper ${M} ==="
  python task_whisper/run_whisper.py --model "${M}" --dataset svarah
done

# Stage 1 — Parakeet TDT + CTC (parakeet env)
conda activate "${PARAKEET_ENV}"
export PATH="${CONDA_PREFIX}/bin:${PATH}" LD_LIBRARY_PATH="${CONDA_PREFIX}/lib:${LD_LIBRARY_PATH}"
for M in parakeet parakeet_ctc; do
  echo -e "\n=== Svarah Stage 1: ${M} ==="
  python task4_parakeet/wer_parakeet.py --model "${M}" --dataset svarah
done

# Stage 1 — Qwen3 (qwen3 env)
conda activate "${QWEN3_ENV}"
export PATH="${CONDA_PREFIX}/bin:${PATH}" LD_LIBRARY_PATH="${CONDA_PREFIX}/lib:${LD_LIBRARY_PATH}"
echo -e "\n=== Svarah Stage 1: qwen3 ==="
python task5_qwen3_asr/wer_qwen3.py --dataset svarah

# Stage 2 + 3 (CPU; whisper env has pandas/jiwer/matplotlib + whisper_normalizer)
conda activate "${WHISPER_ENV}"
export PATH="${CONDA_PREFIX}/bin:${PATH}" LD_LIBRARY_PATH="${CONDA_PREFIX}/lib:${LD_LIBRARY_PATH}"
echo -e "\n=== Svarah Stage 2 + 3 ==="
python normalize_and_score.py --dataset svarah
python analysis/compare_all.py --dataset svarah
python analysis/statistics.py --dataset svarah
python analysis/error_analysis.py --dataset svarah
python analysis/entity_analysis.py --dataset svarah
python paper/figures/make_paper_figures.py --dataset tie,svarah

echo "=== Svarah pipeline complete $(date) ==="
