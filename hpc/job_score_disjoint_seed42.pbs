#!/bin/bash
#PBS -N asr_ft_disjoint_seed42_score
#PBS -l select=1:ngpus=1:ncpus=8:mem=64gb
#PBS -l walltime=2:00:00
#PBS -P ${PBS_PROJECT:-your_project_id}
#PBS -o logs/
#PBS -j oe
#PBS -k oed
#PBS -V

# One-off: the seed-42 speaker-disjoint fine-tune (job_finetune_disjoint.pbs) trained
# a checkpoint but its Stage 1 transcription never landed in results/ (no
# wer_medium_ft_disjoint_raw.csv exists in git history or on the cluster - the job
# evidently died or was superseded before reaching Stage 1). The checkpoint itself is
# intact at FT_DISJOINT_OUTPUT. This job ONLY transcribes + rescores it - no retrain.
#
#   qsub hpc/job_score_disjoint_seed42.pbs

WORKDIR=${WORKDIR:-${PBS_O_WORKDIR:-$(pwd)}}
CONDA_BASE=${CONDA_BASE:-$(conda info --base 2>/dev/null || echo "/opt/conda")}
WHISPER_FT_ENV=${WHISPER_FT_ENV:-whisper_medium_ft}
WHISPER_ENV=${WHISPER_ENV:-whisper}
HF_CACHE=${HF_CACHE:-${HOME}/.cache/huggingface}
CUDA_MODULE=${CUDA_MODULE:-cuda/11.8.0}
FT_DISJOINT_OUTPUT=${FT_DISJOINT_OUTPUT:-models/whisper_medium_ft_disjoint}

module load "${CUDA_MODULE}" 2>/dev/null || true
source "${CONDA_BASE}/etc/profile.d/conda.sh"
export HF_DATASETS_CACHE="${HF_CACHE}" HF_HOME="${HF_CACHE}"
mkdir -p "${HF_CACHE}" "${WORKDIR}/logs"
cd "${WORKDIR}"

if [ ! -f "${FT_DISJOINT_OUTPUT}/config.json" ]; then
    echo "[FATAL] no checkpoint at FT_DISJOINT_OUTPUT=${FT_DISJOINT_OUTPUT} (config.json missing)"
    exit 1
fi

conda activate "${WHISPER_FT_ENV}"
export LD_LIBRARY_PATH="${CONDA_PREFIX}/lib:${LD_LIBRARY_PATH}"

echo "=== Stage 1: transcribe seed-42 disjoint checkpoint $(date) ==="
MODEL_NAME=medium_ft_disjoint MODEL_SOURCE="${FT_DISJOINT_OUTPUT}" \
    python task6_whisper_medium_ft/wer_whisper_medium_ft.py

echo "=== Stage 2 + 3: rescore + FT comparison (all 3 seeds now present) ==="
conda activate "${WHISPER_ENV}"
python normalize_and_score.py --dataset tie
python analysis/compare_finetune.py

echo "=== seed-42 disjoint scoring complete $(date) ==="
