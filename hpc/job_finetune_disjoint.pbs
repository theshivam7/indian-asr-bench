#!/bin/bash
#PBS -N asr_bench_ft_disjoint
#PBS -l select=1:ngpus=1:ncpus=8:mem=64gb
#PBS -l walltime=10:00:00
#PBS -P ${PBS_PROJECT:-your_project_id}
#PBS -o logs/ft_disjoint.log
#PBS -e logs/ft_disjoint.log
#PBS -j oe
#PBS -V

# Speaker-disjoint fine-tune of Whisper Medium: train with every test speaker
# removed from the training set, evaluate on the SAME test set as medium_hf. Hardens
# the null result ("even with zero speaker overlap, fine-tuning does not help").
# Trains, then transcribes the fine-tuned model, rescores, and rebuilds the FT report.

WORKDIR=${WORKDIR:-${PBS_O_WORKDIR:-$(pwd)}}
CONDA_BASE=${CONDA_BASE:-$(conda info --base 2>/dev/null || echo "/opt/conda")}
WHISPER_FT_ENV=${WHISPER_FT_ENV:-whisper_medium_ft}
WHISPER_ENV=${WHISPER_ENV:-whisper}
HF_CACHE=${HF_CACHE:-${HOME}/.cache/huggingface}
CUDA_MODULE=${CUDA_MODULE:-cuda/11.8.0}

module load "${CUDA_MODULE}" 2>/dev/null || true
source "${CONDA_BASE}/etc/profile.d/conda.sh"
export HF_DATASETS_CACHE="${HF_CACHE}" HF_HOME="${HF_CACHE}"
mkdir -p "${HF_CACHE}" "${WORKDIR}/logs" "${WORKDIR}/models"
cd "${WORKDIR}"

conda activate "${WHISPER_FT_ENV}"
export LD_LIBRARY_PATH="${CONDA_PREFIX}/lib:${LD_LIBRARY_PATH}"

echo "=== Stage 0: speaker-disjoint fine-tune $(date) ==="
FT_SPEAKER_DISJOINT=1 FT_OUTPUT_DIR="models/whisper_medium_ft_disjoint" \
    python task6_whisper_medium_ft/finetune.py

echo "=== Stage 1: transcribe fine-tuned (disjoint) model on test ==="
MODEL_NAME=medium_ft_disjoint MODEL_SOURCE="models/whisper_medium_ft_disjoint" \
    python task6_whisper_medium_ft/wer_whisper_medium_ft.py

echo "=== Stage 2 + 3: rescore + FT comparison ==="
conda activate "${WHISPER_ENV}"
python normalize_and_score.py --dataset tie
python analysis/compare_finetune.py

echo "=== speaker-disjoint FT complete $(date) ==="
