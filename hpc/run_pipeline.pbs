#!/bin/bash
#PBS -N indian_asr_bench_pipeline
#PBS -l select=1:ngpus=1:ncpus=8:mem=64gb
#PBS -l walltime=12:00:00
#PBS -o logs/pipeline.log
#PBS -e logs/pipeline.log
#PBS -j oe
#PBS -k oed

set -euo pipefail

# Full from-scratch benchmark for one dataset: all inference models -> Stage 2 ->
# Stage 3 (compare + statistics + error analysis + figures). Set DATASET (default tie).
#   qsub -P <project_id> -v DATASET=svarah hpc/run_pipeline.pbs
# For an already-benchmarked dataset you usually DON'T need this, reuse the committed
# raw transcripts and just run hpc/job_score.pbs (CPU).

WORKDIR=${WORKDIR:-${PBS_O_WORKDIR:-$(pwd)}}
CONDA_BASE=${CONDA_BASE:-$(conda info --base 2>/dev/null || echo "/opt/conda")}
WHISPER_ENV=${WHISPER_ENV:-${SCRATCH:-/scratch/users/ntu/$USER}/envs/whisper}
PARAKEET_ENV=${PARAKEET_ENV:-${SCRATCH:-/scratch/users/ntu/$USER}/envs/parakeet_env}
QWEN3_ENV=${QWEN3_ENV:-${SCRATCH:-/scratch/users/ntu/$USER}/envs/qwen3_env}
# Default to scratch: $HOME is quota-limited on this cluster and a dataset cache
# will exhaust it mid-run, while scratch has room. Override with -v HF_CACHE=...
HF_CACHE=${HF_CACHE:-${SCRATCH:-/scratch/users/ntu/$USER}/hf_cache}
CUDA_MODULE=${CUDA_MODULE:-cuda/11.8.0}
DATASET=${DATASET:-tie}

module load "${CUDA_MODULE}" 2>/dev/null || true
source "${CONDA_BASE}/etc/profile.d/conda.sh"
export HF_DATASETS_CACHE="${HF_CACHE}" HF_HOME="${HF_CACHE}" XDG_CACHE_HOME="${HF_CACHE}"
mkdir -p "${HF_CACHE}" "${WORKDIR}/logs"
cd "${WORKDIR}"

echo "================================================================"
echo "Indian-ASR-Bench full pipeline, dataset=${DATASET}: $(date) on $(hostname)"
echo "================================================================"

# Stage 1. Whisper family
conda activate "${WHISPER_ENV}" || { echo "[FATAL] conda activate failed for '${WHISPER_ENV}'"; conda info --envs; exit 1; }
# Conda's activation hooks don't reliably fire in a non-interactive PBS batch shell,
# so the env's own libstdc++/libav* stay off the loader path and the system /lib64
# copies win. That surfaces as an ImportError naming CXXABI_1.3.15 or a missing
# libavutil, both of which read as a broken install rather than a path problem.
export PATH="${CONDA_PREFIX}/bin:${PATH}" LD_LIBRARY_PATH="${CONDA_PREFIX}/lib:${LD_LIBRARY_PATH:-}"
for M in tiny base small medium large large_v3_turbo; do
  echo -e "\n=== Stage 1: whisper ${M} ==="
  python whisper_asr/run_whisper.py --model "${M}" --dataset "${DATASET}"
done

# Stage 1. Parakeet TDT + CTC
conda activate "${PARAKEET_ENV}" || { echo "[FATAL] conda activate failed for '${PARAKEET_ENV}'"; conda info --envs; exit 1; }
export PATH="${CONDA_PREFIX}/bin:${PATH}" LD_LIBRARY_PATH="${CONDA_PREFIX}/lib:${LD_LIBRARY_PATH:-}"
for M in parakeet parakeet_ctc; do
  echo -e "\n=== Stage 1: ${M} ==="
  python parakeet/wer_parakeet.py --model "${M}" --dataset "${DATASET}"
done

# Stage 1. Qwen3-ASR
conda activate "${QWEN3_ENV}" || { echo "[FATAL] conda activate failed for '${QWEN3_ENV}'"; conda info --envs; exit 1; }
export PATH="${CONDA_PREFIX}/bin:${PATH}" LD_LIBRARY_PATH="${CONDA_PREFIX}/lib:${LD_LIBRARY_PATH:-}"
echo -e "\n=== Stage 1: qwen3 ==="
python qwen3/wer_qwen3.py --dataset "${DATASET}"

# Stage 2 + 3 (CPU)
conda activate "${WHISPER_ENV}" || { echo "[FATAL] conda activate failed for '${WHISPER_ENV}'"; conda info --envs; exit 1; }
export PATH="${CONDA_PREFIX}/bin:${PATH}" LD_LIBRARY_PATH="${CONDA_PREFIX}/lib:${LD_LIBRARY_PATH:-}"
echo -e "\n=== Stage 2 + 3 ==="
python normalize_and_score.py --dataset "${DATASET}"
python analysis/compare_all.py --dataset "${DATASET}"
python analysis/statistics.py --dataset "${DATASET}"
python analysis/error_analysis.py --dataset "${DATASET}"
[ "${DATASET}" = "svarah" ] && python analysis/entity_analysis.py --dataset svarah
if [ -f paper/figures/make_paper_figures.py ]; then
    python paper/figures/make_paper_figures.py --dataset "${DATASET}"
else
    echo "[skip] paper/ is local-only (not tracked in git) - generate figures locally"
fi

echo "================================================================"
echo "Pipeline complete: $(date), results in ${WORKDIR}/results/${DATASET}/"
echo "================================================================"
