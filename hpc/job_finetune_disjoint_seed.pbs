#!/bin/bash
#PBS -N asr_ft_disjoint_seed
#PBS -l select=1:ngpus=1:ncpus=8:mem=64gb
#PBS -l walltime=10:00:00
#PBS -P ${PBS_PROJECT:-your_project_id}
#PBS -o logs/
#PBS -j oe
#PBS -k oed
#PBS -V

# Seed replicate of the speaker-disjoint fine-tune. The seed-42 run is
# job_finetune_disjoint.pbs; this job trains + evaluates one additional seed so
# the null result is demonstrably not one seed's variance. Submit as:
#
#   qsub -v SEED=43 hpc/job_finetune_disjoint_seed.pbs
#   qsub -v SEED=44 hpc/job_finetune_disjoint_seed.pbs
#
# Output log lands in logs/asr_ft_disjoint_seed.o<jobid> (one per submission).

if [ -z "${SEED}" ]; then
    echo "[FATAL] SEED is not set. Submit with: qsub -v SEED=43 $0"
    exit 1
fi

WORKDIR=${WORKDIR:-${PBS_O_WORKDIR:-$(pwd)}}
CONDA_BASE=${CONDA_BASE:-$(conda info --base 2>/dev/null || echo "/opt/conda")}
WHISPER_FT_ENV=${WHISPER_FT_ENV:-whisper_medium_ft}
WHISPER_ENV=${WHISPER_ENV:-whisper}
HF_CACHE=${HF_CACHE:-${HOME}/.cache/huggingface}
CUDA_MODULE=${CUDA_MODULE:-cuda/11.8.0}

module load "${CUDA_MODULE}" 2>/dev/null || true
source "${CONDA_BASE}/etc/profile.d/conda.sh"
export HF_DATASETS_CACHE="${HF_CACHE}" HF_HOME="${HF_CACHE}"
mkdir -p "${HF_CACHE}" "${WORKDIR}/logs" "${WORKDIR}/models"
cd "${WORKDIR}"

conda activate "${WHISPER_FT_ENV}"
export LD_LIBRARY_PATH="${CONDA_PREFIX}/lib:${LD_LIBRARY_PATH}"

echo "--- GPU / CUDA diagnostics (seed ${SEED}) ---"
nvidia-smi --query-gpu=name,memory.used,memory.total --format=csv 2>&1 || echo "[WARN] nvidia-smi unavailable"
python -c "import torch,sys; ok=torch.cuda.is_available(); print('torch sees CUDA:', ok); sys.exit(0 if ok else 1)" \
    || { echo "[FATAL] CUDA not available in ${WHISPER_FT_ENV} - aborting before a 10h CPU-bound training run"; exit 1; }

# Keep the (~3GB) fine-tuned weights off the quota-limited $HOME: derive from
# FT_DISJOINT_OUTPUT when submit_all.sh provides it (scratch), else repo-local.
FT_OUT="${FT_DISJOINT_OUTPUT:-models/whisper_medium_ft_disjoint}_s${SEED}"
MODEL_KEY="medium_ft_disjoint_s${SEED}"
mkdir -p "$(dirname "${FT_OUT}")"

echo "=== Stage 0: speaker-disjoint fine-tune, seed ${SEED} $(date) ==="
FT_SPEAKER_DISJOINT=1 FT_SEED="${SEED}" FT_OUTPUT_DIR="${FT_OUT}" \
    python task6_whisper_medium_ft/finetune.py

echo "=== Stage 1: transcribe ${MODEL_KEY} on test ==="
MODEL_NAME="${MODEL_KEY}" MODEL_SOURCE="${FT_OUT}" \
    python task6_whisper_medium_ft/wer_whisper_medium_ft.py

# Stage 2/3 deliberately NOT run here: two seed jobs finishing near-simultaneously
# would race on the shared results/tie Stage-2/3 files. submit_all.sh --phase seeds
# chains ONE job_score.pbs (afterok both seeds) to rescore everything once.
echo "=== disjoint FT seed ${SEED} complete (raw CSV written; scoring deferred) $(date) ==="
