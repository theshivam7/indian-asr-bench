#!/bin/bash
#PBS -N asr_bench_score
#PBS -l select=1:ncpus=4:mem=16gb
#PBS -l walltime=1:00:00
#PBS -P ${PBS_PROJECT:-your_project_id}
#PBS -o logs/score.log
#PBS -e logs/score.log
#PBS -j oe
#PBS -k oed

# CPU-only: recompute Stage 2 (scoring) + Stage 3 (analysis/figures) from the
# committed raw transcripts. No GPU, no inference. Use this after a normalization or
# metric change. Set DATASET (default tie).
#   qsub -v DATASET=svarah hpc/job_score.pbs

WORKDIR=${WORKDIR:-${PBS_O_WORKDIR:-$(pwd)}}
CONDA_BASE=${CONDA_BASE:-$(conda info --base 2>/dev/null || echo "/opt/conda")}
WHISPER_ENV=${WHISPER_ENV:-${SCRATCH:-/scratch/users/ntu/$USER}/envs/whisper}
HF_CACHE=${HF_CACHE:-${SCRATCH:-/scratch/users/ntu/$USER}/hf_cache}
DATASET=${DATASET:-tie}

source "${CONDA_BASE}/etc/profile.d/conda.sh"
export HF_DATASETS_CACHE="${HF_CACHE}" HF_HOME="${HF_CACHE}"
mkdir -p "${WORKDIR}/logs"
cd "${WORKDIR}"
conda activate "${WHISPER_ENV}" || { echo "[FATAL] conda activate failed for '${WHISPER_ENV}'"; conda info --envs; exit 1; }
# Conda's activation hooks don't reliably fire in a non-interactive PBS batch shell,
# so the env's own libstdc++/libav* stay off the loader path and the system /lib64
# copies win. That surfaces as an ImportError naming CXXABI_1.3.15 or a missing
# libavutil, both of which read as a broken install rather than a path problem.
export PATH="${CONDA_PREFIX}/bin:${PATH}" LD_LIBRARY_PATH="${CONDA_PREFIX}/lib:${LD_LIBRARY_PATH}"
echo "=== Scoring + analysis for dataset '${DATASET}' $(date) ==="
python normalize_and_score.py --dataset "${DATASET}"
python analysis/compare_all.py --dataset "${DATASET}"
python analysis/statistics.py --dataset "${DATASET}"
python analysis/error_analysis.py --dataset "${DATASET}"
case "${DATASET}" in
    tie|aesrc) python analysis/compare_finetune.py --dataset "${DATASET}" ;;
esac
[ "${DATASET}" = "svarah" ] && python analysis/entity_analysis.py --dataset svarah
if [ -f paper/figures/make_paper_figures.py ]; then
    python paper/figures/make_paper_figures.py --dataset "${DATASET}"
else
    echo "[skip] paper/ is local-only (not tracked in git) - generate figures locally"
fi
echo "=== done $(date) ==="
