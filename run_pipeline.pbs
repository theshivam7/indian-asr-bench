#!/bin/bash
#PBS -N TIE_WER_pipeline
#PBS -l select=1:ngpus=1:ncpus=8:mem=64gb
#PBS -l walltime=10:00:00
#PBS -P personal-REDACTED_NSCC_USER
#PBS -o logs/pipeline.log
#PBS -e logs/pipeline.err
#PBS -j oe

echo "================================================================"
echo "TIE WER Pipeline — Stage 1 (All 5 Models) + Stage 2 + Analysis"
echo "Job started: $(date)"
echo "Node: $(hostname)"
echo "================================================================"

# --------------- Setup ---------------
WORKDIR=/scratch/users/ntu/REDACTED_NSCC_USER/indian-asr-bench
cd $WORKDIR

# cu118 works for all envs (whisper, parakeet, qwen3); driver 12.4 is backward compatible
module load cuda/11.8.0
export LD_LIBRARY_PATH=/app/libs/cudnn/12-8.9.4.25/lib:$LD_LIBRARY_PATH

source /app/apps/miniforge3/25.3.1/etc/profile.d/conda.sh
conda activate /scratch/users/ntu/REDACTED_NSCC_USER/envs/whisper

export HF_DATASETS_CACHE=/scratch/users/ntu/REDACTED_NSCC_USER/hf_cache
export HF_HOME=/scratch/users/ntu/REDACTED_NSCC_USER/hf_cache
export WHISPER_CACHE=/scratch/users/ntu/REDACTED_NSCC_USER/whisper_cache
mkdir -p $HF_DATASETS_CACHE $WHISPER_CACHE logs \
    results/stage1_raw_transcripts \
    results/stage2_processed \
    results/analysis

echo ""
echo "Python: $(which python)"
echo "CUDA: $(python -c 'import torch; print(torch.cuda.is_available())')"
echo "GPU: $(python -c 'import torch; print(torch.cuda.get_device_name(0) if torch.cuda.is_available() else "none")')"

# --------------- Stage 1: ASR Transcription ---------------
echo ""
echo "================================================================"
echo "STAGE 1: Whisper Base Transcription"
echo "================================================================"
python task1_whisper_base/wer_whisper_base.py

echo ""
echo "================================================================"
echo "STAGE 1: Whisper Medium Transcription"
echo "================================================================"
python task2_whisper_medium/wer_whisper_medium.py

echo ""
echo "================================================================"
echo "STAGE 1: Whisper Large Transcription"
echo "================================================================"
python task3_whisper_large/wer_whisper_large.py

# --------------- Stage 1: Parakeet-TDT (separate env) ---------------
echo ""
echo "================================================================"
echo "STAGE 1: Parakeet-TDT-0.6B-v2 Transcription"
echo "================================================================"
conda activate /scratch/users/ntu/REDACTED_NSCC_USER/envs/parakeet_env
python task4_parakeet/wer_parakeet.py

# --------------- Stage 1: Qwen3-ASR (separate env) ---------------
echo ""
echo "================================================================"
echo "STAGE 1: Qwen3-ASR-1.7B Transcription"
echo "================================================================"
conda activate /scratch/users/ntu/REDACTED_NSCC_USER/envs/qwen3_env
python task5_qwen3_asr/wer_qwen3.py

# --------------- Stage 2 + Analysis (whisper env has all deps) ---------------
conda activate /scratch/users/ntu/REDACTED_NSCC_USER/envs/whisper

echo ""
echo "================================================================"
echo "STAGE 2: Normalization + WER Computation"
echo "================================================================"
python normalize_and_score.py

# --------------- Analysis ---------------
echo ""
echo "================================================================"
echo "ANALYSIS: Cross-model comparison + charts"
echo "================================================================"
python analysis/compare_all.py

echo ""
echo "================================================================"
echo "Pipeline complete: $(date)"
echo "Results: $WORKDIR/results/"
echo "================================================================"
