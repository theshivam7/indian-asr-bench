#!/bin/bash
#PBS -N fix_qwen3_env
#PBS -l select=1:ngpus=1:ncpus=4:mem=16gb
#PBS -l walltime=01:00:00
#PBS -q g2
#PBS -P personal-REDACTED_NSCC_USER
#PBS -o logs/fix_qwen3_env.log
#PBS -e logs/fix_qwen3_env.log
#PBS -j oe

module load cuda/11.8.0
export LD_LIBRARY_PATH=/app/libs/cudnn/12-8.9.4.25/lib:$LD_LIBRARY_PATH

source /app/apps/miniforge3/25.3.1/etc/profile.d/conda.sh
conda activate /scratch/users/ntu/REDACTED_NSCC_USER/envs/qwen3_env

cd /scratch/users/ntu/REDACTED_NSCC_USER/indian-asr-bench
mkdir -p logs

echo "=== BEFORE ==="
python -c "import torch; print('torch:', torch.__version__); print('cuda build:', torch.version.cuda); print('cuda available:', torch.cuda.is_available())"

# Remove broken CUDA-13.0 torch
conda remove -y pytorch torchaudio pytorch-cuda pytorch-mutex --force-remove 2>/dev/null || true
pip uninstall -y torch torchaudio torchvision 2>/dev/null || true

# Reinstall torch 2.5.1 cu118
conda install -y \
    "pytorch==2.5.1" \
    "torchaudio==2.5.1" \
    "pytorch-cuda=11.8" \
    -c pytorch -c nvidia

echo "=== AFTER ==="
python -c "import torch; print('torch:', torch.__version__); print('cuda build:', torch.version.cuda)"
python -c "import transformers; print('transformers:', transformers.__version__)"
python -c "from qwen_asr import Qwen3ASRModel; print('qwen_asr: OK')"

echo "=== GPU CHECK ==="
python -c "
import torch
print('cuda available:', torch.cuda.is_available())
if torch.cuda.is_available():
    print('GPU:', torch.cuda.get_device_name(0))
else:
    print('FAIL - CUDA not available on GPU node')
"

echo "Fix done. Verify all checks pass before running job_qwen3.pbs"
