#!/bin/bash
#PBS -N parakeet_asr
#PBS -l select=1:ngpus=1:ncpus=8:mem=32gb
#PBS -l walltime=03:00:00
#PBS -P personal-REDACTED_NSCC_USER
#PBS -o logs/parakeet.log
#PBS -e logs/parakeet.err
#PBS -j oe

module load cuda/11.8.0
export LD_LIBRARY_PATH=/app/libs/cudnn/11-8.9.4.25/lib:$LD_LIBRARY_PATH

source /app/apps/miniforge3/25.3.1/etc/profile.d/conda.sh
conda activate /scratch/users/ntu/REDACTED_NSCC_USER/envs/parakeet_env

export HF_DATASETS_CACHE=/scratch/users/ntu/REDACTED_NSCC_USER/hf_cache
export HF_HOME=/scratch/users/ntu/REDACTED_NSCC_USER/hf_cache
mkdir -p $HF_DATASETS_CACHE logs

cd /scratch/users/ntu/REDACTED_NSCC_USER/indian-asr-bench

# Fix torch CUDA version if not cu118 — use pip (conda has plugin issues on PBS nodes)
TORCH_CUDA=$(python -c "import torch; print(torch.version.cuda)" 2>/dev/null || echo "none")
echo "=== Detected torch CUDA build: $TORCH_CUDA ==="
if [ "$TORCH_CUDA" != "11.8" ]; then
    echo "=== Reinstalling torch cu118 via pip (current: $TORCH_CUDA) ==="
    pip install \
        torch==2.5.1+cu118 \
        torchaudio==2.5.1+cu118 \
        --index-url https://download.pytorch.org/whl/cu118 \
        --no-deps --quiet
    echo "=== Torch reinstall done ==="
fi

echo "=== ENV CHECK ==="
python -c "import torch; print('torch:', torch.__version__, '| cuda build:', torch.version.cuda, '| gpu:', torch.cuda.get_device_name(0) if torch.cuda.is_available() else 'CPU-ONLY')"
python -c "import nemo.collections.asr; print('nemo: OK')"
echo "=== END ENV CHECK ==="

python task4_parakeet/wer_parakeet.py
